# Copy this file to .env.production and put your Render backend URL in it.
# `npm run build` reads it, so the built site calls the cloud backend.
# (This is a public address, not a secret.)
#
# Format: https://<render-service-name>.onrender.com/balaji-finance
VITE_API_BASE=https://sri-balaji-finance-api.onrender.com/balaji-finance
